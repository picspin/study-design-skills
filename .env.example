# Never commit real credentials. Load these only in the local MCP process.
# Product-specific keys take precedence; NATURE_API_KEY is a compatibility fallback.
NATURE_OPENACCESS_API_KEY=
NATURE_META_API_KEY=
NATURE_API_KEY=
SCOPUS_API_KEY=
NCBI_API_KEY=

# HTTP MCP defaults to loopback only.
STUDY_DESIGN_MCP_HOST=127.0.0.1
STUDY_DESIGN_MCP_PORT=8765
STUDY_DESIGN_MCP_TRANSPORT=streamable-http
